<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Только твоё сообщение, без дат/уровней -->
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Твои пакеты — тут будут твои INFO -->
    <logger name="com.example.userservice" level="INFO" />

    <!-- Hibernate: только ошибки, никаких WARN/INFO/DEBUG -->
    <logger name="org.hibernate" level="ERROR" />

    <!-- PostgreSQL драйвер тоже можно приглушить -->
    <logger name="org.postgresql" level="ERROR" />

    <root level="ERROR">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
